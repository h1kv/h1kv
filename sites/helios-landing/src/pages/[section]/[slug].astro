---
import Base from '../../layouts/Base.astro';
import { site } from '../../config/site';
import { formatDate } from '../../lib/format';
import { getCollection, render } from 'astro:content';
import type { CollectionKey } from 'astro:content';

// A page per entry, but only for "writing" sections. "list" sections
// (bookshelf, questions, …) render entirely on their index page.
// Server-rendered: resolve section + entry from the URL params, 404 otherwise.
const section = site.sections.find(
  (s) => s.slug === Astro.params.section && s.type === 'writing'
);
if (!section) return new Response(null, { status: 404 });

const entries = (await getCollection(section.slug as CollectionKey)) as any[];
const entry = entries.find((e) => e.id === Astro.params.slug);
if (!entry) return new Response(null, { status: 404 });

const { Content } = await render(entry);
---
<Base title={entry.data.title} description={entry.data.description}>
  <article class="prose">
    <h1>{entry.data.title}</h1>
    {entry.data.date && <span class="post-date">{formatDate(entry.data.date)}</span>}
    <Content />
  </article>
  <a class="back" href={`/${section.slug}/`}>← {section.title}</a>
</Base>
